# BinSifter runtime data - never commit case/scan data or local machine paths
.bsifter-settings-cache.json
Reports/
Blocklist/
/Attack/
/AttackData/
generated_rules/

# Local dev/testing scratch
Archive/
smoketest/samples/

# Authenticode catalog (.cat) files for catalog-based signature verification
# (see binsifter/core/authenticode.py) - real .cat files are pulled from a
# specific machine's own CatRoot/case data, never project source. This is
# the temporary project-directory location requested
# (2026-08-08) - drop a real .cat here and point Settings' "Catalog
# Directory" field at it for testing, then relocate/repoint whenever you
# settle on a permanent location.
Catalogs/

# Local machine fix script - not project source
*_workspaceFix.ps1
*_workspaceFix_*.log

# OS junk
Thumbs.db
.DS_Store
desktop.ini

# Editor junk
.vscode/
*.user

# Future Python rewrite artifacts
__pycache__/
*.pyc
.venv/
venv/
build/
dist/
*.egg-info/

# Installer build output - generated by installer/build_winnow.ps1 /
# build_rowan.ps1, never source (see installer/README.md)
installer/dist/
installer/build/
installer/Output/

# Superseded PowerShell-version doc, removed as part of the Python rewrite -
# ignored (not just deleted) so it doesn't get silently re-tracked if it
# ever reappears untracked (old branch checkout, editor auto-restore, etc.)
BinSifter_v1.2.1_Tutorial.md
